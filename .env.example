# Copy to .env.local and fill in from Supabase Dashboard -> Settings -> API.
# Both values are safe to expose in browser code: the anon key only grants what
# your RLS policies allow. Never put the service_role key in here — Vite inlines
# every VITE_-prefixed variable into the client bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
