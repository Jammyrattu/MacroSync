{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    {
      "source": "/((?!assets/|favicon.svg|privacy.html|terms.html).*)",
      "destination": "/index.html"
    }
  ]
}
